    <axis xyz="0 0 1"/>
    <limit effort="57" lower="-2.9671" upper="2.9671" velocity="3.8397"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
