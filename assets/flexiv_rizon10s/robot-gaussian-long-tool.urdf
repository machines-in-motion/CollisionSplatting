    <limit effort="57" lower="-2.9671" upper="2.9671" velocity="3.8397"/>
  </joint>

   <joint name="joint7" type="fixed">
    <parent link="link7"/>
    <child link="endeffector"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="9.2"/>
      <origin rpy="0 0 0" xyz="0.0 -0.0 0.13"/>
      <inertia ixx="0.08" ixy="0.0" ixz="-0.0" iyy="0.08" iyz="0.0" izz="0.04"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/visual/base_link.obj" />
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="gaussians/base_link.ply" />
      </geometry>
    </visual>
  </link>


  <link name="link1">
